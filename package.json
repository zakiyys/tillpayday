{
  "name": "self-hosted-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3070",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3070",
    "worker": "tsx src/server/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "secrets": "tsx scripts/gen-secrets.ts",
    "scan:secrets": "sh scripts/scan-secrets.sh",
    "scan:private": "sh scripts/scan-private.sh",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "decimal.js": "10.6.0",
    "idb": "8.0.3",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
