# systemd unit for the background worker (recurring entries, bills, recap, notifications, backups).
[Unit]
Description=TillPayDay worker
After=network.target postgresql.service tillpayday.service

[Service]
Type=simple
User=ledger
WorkingDirectory=/opt/tillpayday
EnvironmentFile=/opt/tillpayday/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx src/server/worker/main.ts
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
