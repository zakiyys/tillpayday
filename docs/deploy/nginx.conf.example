# Reverse proxy (nginx). TLS certificates are up to you (for example certbot).
server {
    listen 443 ssl;
    http2 on;
    server_name finance.example.invalid;

    ssl_certificate     /etc/ssl/certs/finance.pem;
    ssl_certificate_key /etc/ssl/private/finance.key;

    client_max_body_size 12m;   # uploads are limited to 10 MB by the app

    location / {
        proxy_pass http://127.0.0.1:3070;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
    }
}
