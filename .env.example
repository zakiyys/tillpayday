# Copy to .env and fill in. Generate the secret values with: npm run secrets
# Never commit .env.

# PostgreSQL connection for the app user (local connections only).
DATABASE_URL=postgresql://finance:replace-with-db-password@127.0.0.1:5432/finance

# Required once to create the owner account. Keep it private.
SETUP_TOKEN=
# Signs session cookies.
SESSION_SECRET=
# Encrypts the AI API key and TOTP secrets stored in the database.
DATA_ENCRYPTION_KEY=
# Encrypts database backups.
BACKUP_ENCRYPTION_KEY=
# Web Push key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The public HTTPS address users open (used for passkeys and push).
PUBLIC_URL=https://finance.example.invalid
# Folder for attachments, backups and other files. Must be outside the web root.
DATA_DIR=./data
# Display name of the app.
APP_NAME=Home Ledger
# Optional: second folder that receives a copy of every encrypted backup.
BACKUP_COPY_DIR=
