# Create .env from this file with fresh secrets:
#   node scripts/gen-secrets.mjs --write
# or, with Docker only:
#   docker run --rm -v "$PWD":/w -w /w node:22-alpine node scripts/gen-secrets.mjs --write
# Then edit PUBLIC_URL. Never commit .env.

# --- Docker Compose path -------------------------------------------------------------------------------------
# Password for the bundled PostgreSQL. Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=
# Host address and port the app listens on. Keep 127.0.0.1 behind a reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=3070

# --- Manual path (no Compose): PostgreSQL connection for the app user, local connections only ---------------
DATABASE_URL=postgresql://finance:replace-with-db-password@127.0.0.1:5432/finance

# --- Secrets (no defaults: the app refuses to start without them) ---------------------------------------------
# Required once to create the owner account. Keep it private.
SETUP_TOKEN=
# Signs session cookies.
SESSION_SECRET=
# Encrypts the AI API key and TOTP secrets stored in the database.
DATA_ENCRYPTION_KEY=
# Encrypts database backups.
BACKUP_ENCRYPTION_KEY=
# Web Push key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Install ---------------------------------------------------------------------------------------------------
# The public HTTPS address users open (used for passkeys, cookies and push).
PUBLIC_URL=https://finance.example.invalid
# Folder for attachments and backups. Must be outside the web root. Compose uses a volume at /data.
DATA_DIR=./data
# Display name of the app.
APP_NAME=TillPayDay
# Optional: second folder that receives a copy of every encrypted backup (for example a mounted remote disk).
BACKUP_COPY_DIR=
# Optional: how many daily backups to keep (default 14).
BACKUP_KEEP=14
